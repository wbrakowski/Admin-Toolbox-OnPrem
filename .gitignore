# VS Code folders: ignore everything except the shared settings
.vscode/*
!.vscode/settings.json
app/.vscode/*
!app/.vscode/settings.json
test/.vscode/*
!test/.vscode/settings.json

# Symbols and caches
.alpackages/
.alcache/
.altemplates/
.snapshots/
.coverage/
.tools

# Old pre-split root folder of the PowerShell runner (the runner now lives in app/.netpackages)
/.netpackages/

# Build output (a release copy of the app is kept in the repo root)
app/*.app
test/*.app

### Windows ###
# Windows thumbnail cache files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db

# Dump file
*.stackdump

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows shortcuts
*.lnk
